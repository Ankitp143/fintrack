<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FinTrack — Personal Finance Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-dark text-white d-flex flex-column min-vh-100">

  <!-- NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary py-3">
    <div class="container">
      <a class="navbar-brand fw-bold text-primary fs-3" href="/">FinTrack 💰</a>
      <div>
        <a href="/login" class="btn btn-outline-light me-2 px-4">Login</a>
        <a href="/register" class="btn btn-primary px-4">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <main class="container my-auto py-5">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <h1 class="display-4 fw-bold mb-3">
          Smart Personal Finance <br><span class="text-primary">Made Simple</span>
        </h1>
        <p class="lead text-secondary mb-4">
          Take control of your financial future. Track income and expenses, set monthly budgets, view analytical reports, and download PDF financial statements seamlessly.
        </p>
        <div class="d-flex gap-3">
          <a href="/register" class="btn btn-primary btn-lg px-4">Start Tracking Free</a>
          <a href="/login" class="btn btn-outline-light btn-lg px-4">Sign In</a>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="card-box text-center p-4">
              <h3 class="text-success mb-1">Income & Expense</h3>
              <p class="text-secondary small mb-0">Categorized tracking</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card-box text-center p-4">
              <h3 class="text-info mb-1">Budget Control</h3>
              <p class="text-secondary small mb-0">Monthly target limits</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card-box text-center p-4">
              <h3 class="text-warning mb-1">Visual Analytics</h3>
              <p class="text-secondary small mb-0">Interactive Chart.js</p>
            </div>
          </div>
          <div class="col-6">
            <div class="card-box text-center p-4">
              <h3 class="text-primary mb-1">PDF Reports</h3>
              <p class="text-secondary small mb-0">Exportable statements</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="border-top border-secondary py-3 text-center text-secondary small">
    <div class="container">
      &copy; 2026 FinTrack. Secure Personal Finance Web Application.
    </div>
  </footer>

</body>
</html>