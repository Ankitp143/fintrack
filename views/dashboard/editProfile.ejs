<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile | FinTrack</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link active">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">Edit Account Profile</h2>
        <p class="text-secondary mb-0">Update your name or change your password.</p>
      </div>
      <a href="/profile" class="btn btn-outline-secondary">← Back to Profile</a>
    </div>

    <!-- ERROR ALERTS -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="card-box mx-auto" style="max-width: 600px;">
      <form method="POST" action="/profile/edit">
        <div class="mb-3">
          <label class="form-label text-secondary small fw-bold">Full Name</label>
          <input 
            type="text" 
            name="name" 
            class="form-control" 
            value="<%= user ? user.name : '' %>" 
            required
          >
        </div>

        <div class="mb-3">
          <label class="form-label text-secondary small fw-bold">Email Address (Read-only)</label>
          <input 
            type="email" 
            class="form-control" 
            value="<%= user ? user.email : '' %>" 
            readonly 
            disabled
          >
          <small class="text-secondary">Email address cannot be changed.</small>
        </div>

        <div class="mb-4">
          <label class="form-label text-secondary small fw-bold">New Password</label>
          <input 
            type="password" 
            name="password" 
            class="form-control" 
            placeholder="Enter new password (optional)"
            minlength="6"
          >
          <small class="text-secondary">Leave blank if you do not wish to change your password.</small>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
            Update Profile
          </button>
          <a href="/profile" class="btn btn-outline-secondary w-50 py-2">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>