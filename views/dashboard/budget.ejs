<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Budget | FinTrack</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link active">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">Monthly Budget Management</h2>
        <p class="text-secondary mb-0">Track expenses for <strong><%= typeof monthName !== 'undefined' ? monthName : 'the Current Month' %></strong>.</p>
      </div>
      <a href="/dashboard" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <!-- ALERTS -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- SET BUDGET FORM -->
    <div class="card-box mb-4 mx-auto" style="max-width: 600px;">
      <h5 class="fw-bold mb-3">Set Monthly Budget Target</h5>
      <form method="POST" action="/budget" class="row g-3 align-items-end">
        <div class="col-sm-8">
          <label class="form-label text-secondary small fw-bold">Budget Amount (Rs.)</label>
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            name="amount" 
            class="form-control" 
            value="<%= budgetAmount || '' %>" 
            placeholder="Enter budget limit" 
            required
          >
        </div>
        <div class="col-sm-4">
          <button type="submit" class="btn btn-primary w-100 fw-semibold py-2">
            Save Target
          </button>
        </div>
      </form>
    </div>

    <!-- BUDGET METRICS CARDS -->
    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">MONTHLY BUDGET TARGET</span>
          <h3 class="text-primary fw-bold mb-0">
            Rs. <%= Number(budgetAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">THIS MONTH'S EXPENSE</span>
          <h3 class="text-danger fw-bold mb-0">
            Rs. <%= Number(totalExpense).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">REMAINING BUDGET</span>
          <h3 class="<%= remaining >= 0 ? 'text-success' : 'text-danger' %> fw-bold mb-0">
            Rs. <%= Number(remaining).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>
    </div>

    <!-- BUDGET PROGRESS BAR -->
    <% if (budgetAmount > 0) { %>
      <% 
        const percentSpent = Math.min(Math.round((totalExpense / budgetAmount) * 100), 100);
        let progressBg = "bg-success";
        if (percentSpent > 75 && percentSpent < 100) progressBg = "bg-warning";
        if (percentSpent >= 100) progressBg = "bg-danger";
      %>
      <div class="card-box">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="fw-semibold">Monthly Budget Consumption</span>
          <span class="badge <%= progressBg %>"><%= percentSpent %>% Spent</span>
        </div>
        <div class="progress bg-dark" style="height: 14px; border-radius: 8px;">
          <div 
            class="progress-bar <%= progressBg %>" 
            role="progressbar" 
            style="width: <%= percentSpent %>%;" 
            aria-valuenow="<%= percentSpent %>" 
            aria-valuemin="0" 
            aria-valuemax="100"
          ></div>
        </div>
        <% if (remaining < 0) { %>
          <small class="text-danger d-block mt-2 font-monospace">
            ⚠️ Warning: You have exceeded your budget by Rs. <%= Math.abs(remaining).toLocaleString('en-IN') %>!
          </small>
        <% } else { %>
          <small class="text-secondary d-block mt-2">
            Remaining allowance for this calendar month: Rs. <%= Number(remaining).toLocaleString('en-IN') %>.
          </small>
        <% } %>
      </div>
    <% } %>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>