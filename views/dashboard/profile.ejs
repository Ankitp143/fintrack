<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile | FinTrack</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link active">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">User Profile</h2>
        <p class="text-secondary mb-0">View account details and summary statistics.</p>
      </div>
      <a href="/profile/edit" class="btn btn-warning px-3">✏️ Edit Profile</a>
    </div>

    <!-- ALERTS -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="row g-4 mb-4">
      <div class="col-md-6">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3 text-primary">Account Information</h5>
          
          <div class="mb-3">
            <label class="text-secondary small font-monospace d-block mb-1">FULL NAME</label>
            <span class="fs-5 fw-bold"><%= user ? user.name : "N/A" %></span>
          </div>

          <div class="mb-3">
            <label class="text-secondary small font-monospace d-block mb-1">EMAIL ADDRESS</label>
            <span class="fs-5 fw-bold"><%= user ? user.email : "N/A" %></span>
          </div>

          <div>
            <label class="text-secondary small font-monospace d-block mb-1">MEMBER SINCE</label>
            <span class="fs-5 fw-bold text-info">
              <%= user && user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %>
            </span>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3 text-primary">Financial Summary</h5>
          
          <div class="row g-3">
            <div class="col-6">
              <div class="bg-dark p-3 rounded border border-secondary">
                <span class="text-secondary small d-block">Total Transactions</span>
                <span class="fs-4 fw-bold text-warning"><%= totalTransactions %></span>
              </div>
            </div>

            <div class="col-6">
              <div class="bg-dark p-3 rounded border border-secondary">
                <span class="text-secondary small d-block">Total Income</span>
                <span class="fs-4 fw-bold text-success">
                  Rs. <%= Number(income).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </span>
              </div>
            </div>

            <div class="col-6">
              <div class="bg-dark p-3 rounded border border-secondary">
                <span class="text-secondary small d-block">Total Expense</span>
                <span class="fs-4 fw-bold text-danger">
                  Rs. <%= Number(expense).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </span>
              </div>
            </div>

            <div class="col-6">
              <div class="bg-dark p-3 rounded border border-secondary">
                <span class="text-secondary small d-block">Net Balance</span>
                <span class="fs-4 fw-bold <%= balance >= 0 ? 'text-primary' : 'text-danger' %>">
                  Rs. <%= Number(balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
