<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Transaction | FinTrack</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link active">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">Edit Transaction</h2>
        <p class="text-secondary mb-0">Modify transaction details.</p>
      </div>
      <a href="/dashboard" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <!-- ERROR ALERTS -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="card-box mx-auto" style="max-width: 650px;">
      <form method="POST" action="/edit/<%= transaction._id %>">
        
        <!-- TITLE -->
        <div class="mb-3">
          <label class="form-label text-secondary small fw-bold">Title / Description</label>
          <input 
            type="text" 
            name="title" 
            class="form-control" 
            value="<%= transaction.title %>" 
            required
          >
        </div>

        <div class="row g-3 mb-3">
          <!-- AMOUNT -->
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-bold">Amount (Rs.)</label>
            <input 
              type="number" 
              step="0.01" 
              min="0.01" 
              name="amount" 
              class="form-control" 
              value="<%= transaction.amount %>" 
              required
            >
          </div>

          <!-- TYPE -->
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-bold">Transaction Type</label>
            <select name="type" class="form-select" required>
              <option value="income" <%= transaction.type === "income" ? "selected" : "" %>>Income</option>
              <option value="expense" <%= transaction.type === "expense" ? "selected" : "" %>>Expense</option>
            </select>
          </div>
        </div>

        <div class="row g-3 mb-3">
          <!-- DATE -->
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-bold">Date</label>
            <input 
              type="date" 
              name="date" 
              class="form-control" 
              value="<%= transaction.date ? new Date(transaction.date).toISOString().split('T')[0] : '' %>" 
              required
            >
          </div>

          <!-- CATEGORY -->
          <div class="col-md-6">
            <label class="form-label text-secondary small fw-bold">Category</label>
            <% 
              const standardCategories = ['Food', 'Shopping', 'Salary', 'Travel', 'Bills', 'Entertainment', 'Investment', 'Health'];
              const isCustom = !standardCategories.includes(transaction.category);
            %>
            <select name="category" id="categorySelect" class="form-select" onchange="toggleCustomCategory()" required>
              <option value="Food" <%= transaction.category === 'Food' ? 'selected' : '' %>>Food & Dining</option>
              <option value="Shopping" <%= transaction.category === 'Shopping' ? 'selected' : '' %>>Shopping</option>
              <option value="Salary" <%= transaction.category === 'Salary' ? 'selected' : '' %>>Salary & Income</option>
              <option value="Travel" <%= transaction.category === 'Travel' ? 'selected' : '' %>>Travel & Fuel</option>
              <option value="Bills" <%= transaction.category === 'Bills' ? 'selected' : '' %>>Bills & Utilities</option>
              <option value="Entertainment" <%= transaction.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
              <option value="Investment" <%= transaction.category === 'Investment' ? 'selected' : '' %>>Investment</option>
              <option value="Health" <%= transaction.category === 'Health' ? 'selected' : '' %>>Health & Medical</option>
              <option value="Other" <%= isCustom ? 'selected' : '' %>>Other (Custom)</option>
            </select>
          </div>
        </div>

        <!-- CUSTOM CATEGORY BOX -->
        <div class="mb-3" id="customCategoryBox" style="display: <%= isCustom ? 'block' : 'none' %>;">
          <label class="form-label text-secondary small fw-bold">Custom Category Name</label>
          <input 
            type="text" 
            name="customCategory" 
            id="customCategory" 
            class="form-control" 
            value="<%= isCustom ? transaction.category : '' %>"
            placeholder="Enter custom category name"
          >
        </div>

        <!-- RECURRING -->
        <div class="mb-4">
          <label class="form-label text-secondary small fw-bold">Is this a Recurring Transaction?</label>
          <select name="recurring" class="form-select">
            <option value="false" <%= !transaction.recurring ? 'selected' : '' %>>No (One-time transaction)</option>
            <option value="true" <%= transaction.recurring ? 'selected' : '' %>>Yes (Recurring transaction)</option>
          </select>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold">
            Update Transaction
          </button>
          <a href="/dashboard" class="btn btn-outline-secondary w-50 py-2">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleCustomCategory() {
      const select = document.getElementById('categorySelect');
      const box = document.getElementById('customCategoryBox');
      const customInput = document.getElementById('customCategory');
      
      if (select.value === 'Other') {
        box.style.display = 'block';
        customInput.required = true;
      } else {
        box.style.display = 'none';
        customInput.required = false;
      }
    }
  </script>
</body>
</html>