<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | FinTrack</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link active">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    
    <!-- HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">
          Welcome back, <%= user ? user.name : "User" %> 👋
        </h2>
        <p class="text-secondary mb-0">Here is your financial overview and transaction log.</p>
      </div>
      <div>
        <a href="/add-transaction" class="btn btn-primary px-3">
          + Add New Transaction
        </a>
      </div>
    </div>

    <!-- ALERTS -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="card-box">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary font-monospace small">TOTAL INCOME</span>
            <span class="badge bg-success bg-opacity-25 text-success">Income</span>
          </div>
          <h3 class="text-success fw-bold mb-0">
            Rs. <%= Number(income).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card-box">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary font-monospace small">TOTAL EXPENSE</span>
            <span class="badge bg-danger bg-opacity-25 text-danger">Expense</span>
          </div>
          <h3 class="text-danger fw-bold mb-0">
            Rs. <%= Number(expense).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card-box">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-secondary font-monospace small">NET BALANCE</span>
            <span class="badge bg-primary bg-opacity-25 text-primary">Balance</span>
          </div>
          <h3 class="<%= balance >= 0 ? 'text-primary' : 'text-danger' %> fw-bold mb-0">
            Rs. <%= Number(balance).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>
    </div>

    <!-- EXPORT PDF STATEMENT SECTION -->
    <div class="card-box mb-5">
      <h5 class="fw-bold mb-3">Export Financial Statement (PDF)</h5>
      <form method="GET" action="/download-report" class="row g-3 align-items-end">
        <div class="col-md-4">
          <label class="form-label text-secondary small fw-semibold">Start Date</label>
          <input type="date" name="startDate" id="pdfStartDate" class="form-control">
        </div>
        <div class="col-md-4">
          <label class="form-label text-secondary small fw-semibold">End Date</label>
          <input type="date" name="endDate" id="pdfEndDate" class="form-control">
        </div>
        <div class="col-md-4">
          <button type="submit" class="btn btn-outline-info w-100 fw-semibold">
            📄 Download PDF Report
          </button>
        </div>
      </form>
      <div class="d-flex flex-wrap gap-2 mt-3">
        <span class="text-secondary small me-2 align-self-center">Quick Presets:</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setPresetDays(30)">Last 30 Days</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setPresetDays(90)">Last 90 Days</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setPresetYear()">This Year</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearPreset()">All Time</button>
      </div>
    </div>

    <!-- CHARTS SECTION -->
    <div class="row g-4 mb-5">
      <div class="col-lg-6">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3">Income vs Expense Ratio</h5>
          <div style="max-height: 280px;" class="d-flex justify-content-center">
            <canvas id="pieChart"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3">Financial Overview</h5>
          <div style="max-height: 280px;" class="d-flex justify-content-center">
            <canvas id="barChart"></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- RECENT TRANSACTIONS TABLE SECTION -->
    <div class="card-box">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <h4 class="fw-bold mb-0">Recent Transactions</h4>
        
        <!-- SEARCH & FILTER FORM -->
        <form method="GET" action="/dashboard" class="d-flex flex-wrap gap-2">
          <input 
            type="text" 
            name="search" 
            class="form-control form-control-sm" 
            placeholder="Search by title..." 
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            style="min-width: 180px;"
          >
          <select name="type" class="form-select form-select-sm" style="min-width: 120px;">
            <option value="">All Types</option>
            <option value="income" <%= type === "income" ? "selected" : "" %>>Income</option>
            <option value="expense" <%= type === "expense" ? "selected" : "" %>>Expense</option>
          </select>
          <button type="submit" class="btn btn-sm btn-primary px-3">Filter</button>
          <% if (search || type) { %>
            <a href="/dashboard" class="btn btn-sm btn-outline-secondary">Reset</a>
          <% } %>
        </form>
      </div>

      <!-- TABLE -->
      <div class="table-responsive">
        <table class="table table-dark table-hover table-custom align-middle mb-0">
          <thead>
            <tr>
              <th>Date</th>
              <th>Title</th>
              <th>Category</th>
              <th>Type</th>
              <th>Recurring</th>
              <th class="text-end">Amount</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (transactions && transactions.length > 0) { %>
              <% transactions.forEach(function(t) { %>
                <tr>
                  <!-- DATE -->
                  <td class="text-secondary small">
                    <%= t.date ? new Date(t.date).toLocaleDateString('en-IN') : 'N/A' %>
                  </td>
                  <!-- TITLE -->
                  <td class="fw-semibold">
                    <%= t.title %>
                  </td>
                  <!-- CATEGORY -->
                  <td>
                    <span class="badge bg-secondary bg-opacity-50 text-light"><%= t.category %></span>
                  </td>
                  <!-- TYPE -->
                  <td>
                    <% if (t.type === "income") { %>
                      <span class="badge bg-success">Income</span>
                    <% } else { %>
                      <span class="badge bg-danger">Expense</span>
                    <% } %>
                  </td>
                  <!-- RECURRING -->
                  <td>
                    <% if (t.recurring) { %>
                      <span class="badge bg-info text-dark">Recurring</span>
                    <% } else { %>
                      <span class="text-secondary small">One-time</span>
                    <% } %>
                  </td>
                  <!-- AMOUNT -->
                  <td class="text-end fw-bold <%= t.type === 'income' ? 'text-success' : 'text-danger' %>">
                    <%= t.type === 'income' ? '+' : '-' %> Rs. <%= Number(t.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                  <!-- ACTIONS -->
                  <td class="text-center">
                    <a href="/edit/<%= t._id %>" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                    <a href="/delete/<%= t._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this transaction?');">Delete</a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-secondary">
                  No transactions found matching your criteria.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- QUICK PRESET DATE RANGE JS -->
  <script>
    function setPresetDays(days) {
      const end = new Date();
      const start = new Date();
      start.setDate(end.getDate() - days);
      document.getElementById('pdfStartDate').value = start.toISOString().split('T')[0];
      document.getElementById('pdfEndDate').value = end.toISOString().split('T')[0];
    }
    function setPresetYear() {
      const end = new Date();
      const start = new Date(end.getFullYear(), 0, 1);
      document.getElementById('pdfStartDate').value = start.toISOString().split('T')[0];
      document.getElementById('pdfEndDate').value = end.toISOString().split('T')[0];
    }
    function clearPreset() {
      document.getElementById('pdfStartDate').value = '';
      document.getElementById('pdfEndDate').value = '';
    }

    // CHART RENDERING
    window.onload = function () {
      const income = <%= income || 0 %>;
      const expense = <%= expense || 0 %>;

      // Pie Chart
      const pieCtx = document.getElementById("pieChart");
      if (pieCtx) {
        new Chart(pieCtx, {
          type: "doughnut",
          data: {
            labels: ["Income", "Expense"],
            datasets: [{
              data: [income, expense],
              backgroundColor: ["#10b981", "#ef4444"],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { labels: { color: "#94a3b8" } }
            }
          }
        });
      }

      // Bar Chart
      const barCtx = document.getElementById("barChart");
      if (barCtx) {
        new Chart(barCtx, {
          type: "bar",
          data: {
            labels: ["Income", "Expense", "Balance"],
            datasets: [{
              label: "Amount (Rs.)",
              data: [income, expense, income - expense],
              backgroundColor: ["#10b981", "#ef4444", "#6366f1"],
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              x: { ticks: { color: "#94a3b8" }, grid: { color: "#334155" } },
              y: { ticks: { color: "#94a3b8" }, grid: { color: "#334155" } }
            }
          }
        });
      }
    };
  </script>
</body>
</html>