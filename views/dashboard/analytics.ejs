<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics | FinTrack</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a href="/dashboard" class="sidebar-brand">
      <span>💰</span> FinTrack
    </a>
    <nav class="sidebar-nav">
      <a href="/dashboard" class="sidebar-link">
        <span>📊</span> Dashboard
      </a>
      <a href="/analytics" class="sidebar-link active">
        <span>📈</span> Analytics
      </a>
      <a href="/add-transaction" class="sidebar-link">
        <span>➕</span> Add Transaction
      </a>
      <a href="/budget" class="sidebar-link">
        <span>🎯</span> Budget
      </a>
      <a href="/profile" class="sidebar-link">
        <span>👤</span> Profile
      </a>
      <a href="/logout" class="sidebar-link text-danger mt-auto">
        <span>🚪</span> Logout
      </a>
    </nav>
  </aside>

  <!-- MAIN CONTENT -->
  <main class="main-content">
    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary">
      <div>
        <h2 class="fw-bold mb-1">Financial Analytics</h2>
        <p class="text-secondary mb-0">Deep dive into your expense distribution and financial trends.</p>
      </div>
      <a href="/dashboard" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">TOTAL INCOME</span>
          <h3 class="text-success fw-bold mb-0">
            Rs. <%= Number(income).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-3">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">TOTAL EXPENSE</span>
          <h3 class="text-danger fw-bold mb-0">
            Rs. <%= Number(expense).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-3">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">NET BALANCE</span>
          <h3 class="<%= balance >= 0 ? 'text-primary' : 'text-danger' %> fw-bold mb-0">
            Rs. <%= Number(balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </h3>
        </div>
      </div>

      <div class="col-md-3">
        <div class="card-box">
          <span class="text-secondary font-monospace small d-block mb-1">TRANSACTIONS</span>
          <h3 class="text-warning fw-bold mb-0">
            <%= totalTransactions %>
          </h3>
        </div>
      </div>
    </div>

    <!-- TOP CATEGORY BANNER -->
    <div class="card-box mb-4 text-center py-4">
      <h6 class="text-secondary font-monospace text-uppercase mb-2">Top Spending Category</h6>
      <h2 class="text-danger fw-bold mb-0">
        <%= topCategory %>
      </h2>
    </div>

    <!-- CHART & BREAKDOWN -->
    <div class="row g-4">
      <div class="col-lg-7">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3">Expense Category Breakdown</h5>
          <% if (Object.keys(categoryData).length > 0) { %>
            <div style="max-height: 320px;" class="d-flex justify-content-center">
              <canvas id="categoryChart"></canvas>
            </div>
          <% } else { %>
            <div class="text-center py-5 text-secondary">
              <p class="mb-0">No expense categories to display yet. Add some expenses to see analytical charts.</p>
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="card-box h-100">
          <h5 class="fw-bold mb-3">Category Details</h5>
          <% if (Object.keys(categoryData).length > 0) { %>
            <ul class="list-group list-group-flush bg-transparent">
              <% Object.keys(categoryData).forEach(function(cat) { %>
                <li class="list-group-item bg-transparent text-white border-secondary d-flex justify-content-between align-items-center px-0">
                  <span class="fw-semibold"><%= cat %></span>
                  <span class="text-danger fw-bold">
                    Rs. <%= Number(categoryData[cat]).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </span>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-secondary small mb-0">No categorized expense data available.</p>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    const categoryData = <%- JSON.stringify(categoryData || {}) %>;
    const labels = Object.keys(categoryData);
    const data = Object.values(categoryData);

    if (labels.length > 0) {
      new Chart(document.getElementById("categoryChart"), {
        type: "doughnut",
        data: {
          labels: labels,
          datasets: [{
            data: data,
            backgroundColor: [
              "#ef4444", "#3b82f6", "#10b981", "#f59e0b", 
              "#8b5cf6", "#ec4899", "#06b6d4", "#84cc16"
            ],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: { color: "#94a3b8" },
              position: "right"
            }
          }
        }
      });
    }
  </script>
</body>
</html>